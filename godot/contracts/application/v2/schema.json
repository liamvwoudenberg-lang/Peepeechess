{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peepeechess.invalid/contracts/application/v2/enet.json",
  "$defs": {
    "AccountHello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "protocol",
        "ticket"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "protocol": {
          "const": "peepeechess-enet-v2"
        },
        "ticket": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
