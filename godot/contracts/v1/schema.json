        "color": {
          "enum": [
            "w",
            "b"
          ]
        },
        "role": {
          "enum": [
            "p",
            "n",
            "b",
            "r",
            "q",
            "k"
          ]
        },
        "characterId": {
          "$ref": "#/$defs/CharacterId"
        }
      },
      "required": [
        "pieceId",
        "square",
        "color",
        "role",
        "characterId"
      ],
      "additionalProperties": false
    },
    "CharacterId": {
      "type": "string",
      "pattern": "^(royal|elves|skeletons)\\.[pnbrqk]$",
      "maxLength": 16
