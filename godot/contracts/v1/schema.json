        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "enum": [
            "INVALID_PAYLOAD",
            "UNSUPPORTED_VERSION",
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "STALE_REVISION",
            "ILLEGAL_MOVE",
            "UNSAFE_OUTCOME",
            "WRONG_PHASE",
            "STALE_INPUT",
            "RATE_LIMITED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 160
        },
        "retryable": {
          "type": "boolean"
        },
        "currentRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "code",
        "message",
        "retryable",
        "currentRevision"
      ],
      "additionalProperties": false
    }
  }
}
