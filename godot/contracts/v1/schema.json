      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-h][1-8]$",
          "maxLength": 2
        },
        "to": {
          "type": "string",
          "pattern": "^[a-h][1-8]$",
          "maxLength": 2
        },
        "promotion": {
          "anyOf": [
            {
              "enum": [
                "q",
                "r",
                "b",
                "n"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "quiet",
            "attacker",
            "defender"
          ]
        },
        "fen": {
          "type": "string",
          "minLength": 15,
          "maxLength": 120,
          "pattern": "^[prnbqkPRNBQK1-8/]+ [wb] (K?Q?k?q?|-+?) ([a-h][36]|-) [0-9]+ [1-9][0-9]*$"
        }
      },
      "required": [
        "from",
        "to",
        "promotion",
        "outcome",
        "fen"
      ],
      "additionalProperties": false
    },
