; Native multiplayer application; the existing web application remains at repository root.
config_version=5

[application]
config/name="Peepeechess"
config/icon="res://ui/app_icon.svg"
config/version="0.3.0-multiplayer"
run/main_scene="res://ui/application.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/size/min_width=640
window/size/min_height=360
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
