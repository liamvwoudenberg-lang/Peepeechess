; Native Classic client; the existing web application remains at repository root.
config_version=5

[application]
config/name="Peepeechess"
config/version="0.2.0-classic"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/size/min_width=360
window/size/min_height=600

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
