extends SceneTree
## Mate-in-1/2/3 and hanging-piece tactics (31 positions), time budget, cancellation and the worker/sliced job.
## Mate positions were generated by search and verified offline with an exhaustive solver; the test re-verifies the
## computer's play: after its first move EVERY defence is tried and the computer must mate within the allowed moves.
const Support = preload("res://tests/ai/ai_support.gd")
const MATE1 = [
	"8/8/8/8/8/3R4/8/k1K4B w - - 0 1", "4k3/6K1/8/8/7B/8/8/3B4 w - - 0 1", "2K3R1/8/7k/7p/6R1/8/8/8 w - - 0 1",
	"4k3/8/4K3/8/8/8/8/6R1 w - - 0 1", "6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1", "6rk/6pp/8/6N1/8/8/8/7K w - - 0 1",
	"8/k1K5/8/8/2Q5/3p4/8/7N w - - 0 1", "7K/8/8/8/8/3R4/6R1/1k6 w - - 0 1", "r5k1/8/8/8/8/8/5PPP/6K1 b - - 0 1",
]
const MATE2 = [
	"4k3/8/7R/4K3/8/8/8/R7 w - - 0 1", "8/1Q6/8/8/k4N2/8/1K6/8 w - - 0 1", "8/8/6K1/4Q1R1/k7/8/8/8 w - - 0 1",
	"4K3/8/7k/Q7/8/8/8/8 w - - 0 1", "k7/8/8/2K5/8/2P5/8/5R2 w - - 0 1", "1R6/8/5Kp1/2k5/8/8/3Q4/8 w - - 0 1",
	"8/8/8/7N/8/8/2KQ2Nk/8 w - - 0 1", "8/2p5/8/2R5/4k3/1K4Q1/8/8 w - - 0 1",
]
const MATE3 = [
	"8/6Q1/8/8/8/2p1P3/k2K4/8 w - - 0 1", "8/2k5/4R3/5R2/8/8/7K/8 w - - 0 1", "R7/8/7K/Q7/8/8/8/1k6 w - - 0 1",
	"7k/7N/8/8/8/7K/8/4QN2 w - - 0 1", "5B2/8/B7/8/8/8/8/5K1k w - - 0 1", "3N1k2/8/8/8/8/8/2Q5/2K5 w - - 0 1",
]
## [fen, accepted first moves]
const WIN_MATERIAL = [
	["4k3/8/8/3q4/8/8/8/3RK3 w - - 0 1", ["d1d5"]],
	["rnb1kbnr/pppp1ppp/8/4p3/4P3/5q2/PPPP1PPP/RNBQKBNR w KQkq - 0 1", ["d1f3", "g2f3", "g1f3"]],
	["4k3/p7/8/8/3n4/8/P4B2/4K3 w - - 0 1", ["f2d4"]],
	["r3k3/8/8/8/8/8/R7/4K3 b - - 0 1", ["a8a2"]],
	["4k3/8/8/8/3b4/2P5/P7/4K3 b - - 0 1", ["d4c3"]],
	["4k3/8/8/8/8/8/n7/R3K3 w - - 0 1", ["a1a2"]],
]
## [fen, square of the attacked piece's colour char, piece letter]: the piece must be safe after the move
const SAVE_PIECE = [
	["4k3/8/8/3p4/2N5/8/8/4K3 w - - 0 1", "N", "w"],
	["3rk3/8/8/8/3Q4/8/8/4K3 w - - 0 1", "Q", "w"],
]
var checks = 0
var failures: Array = []
var solved = {"m1": 0, "m2": 0, "m3": 0}
var nodes_used = {"m1": 0, "m2": 0, "m3": 0}
func expect(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		failures.append(label)
		printerr("FAIL: ", label)
func _init() -> void:
	call_deferred("run")

func new_ai(level: int) -> ChessAI:
	var ai = ChessAI.new(level, 3)
	ai.deterministic = true  # node/depth limits only: results do not depend on how busy the machine is
	return ai

## true when the side to move can be forced into mate within `moves` own moves, with the computer choosing our moves
## and every legal defence tried.
func forced_mate(engine, ai: ChessAI, moves: int, stats: Dictionary) -> bool:
	var choice = ai.choose_move(engine)
	stats.nodes += choice.nodes
	if not choice.ok:
		return false
	var played = engine.move(choice.from, choice.to, choice.promotion if choice.promotion != "" else "q")
	if not played.ok:
		return false
	var good = false
	if engine.result != "" and engine.reason == "Checkmate":
		good = true
	elif engine.result == "" and moves > 1:
		good = true
		for reply in engine.legal_moves():
			if not good:
				break
			var r = engine.move(ClassicChess.square(reply.from), ClassicChess.square(reply.to), reply.promotion if reply.promotion != "" else "q")
			if r.ok:
				good = forced_mate(engine, ai, moves - 1, stats)
				engine.undo()
	engine.undo()
	return good

func run_mates(list: Array, moves: int, level: int, key: String) -> void:
	for fen in list:
		var engine = ClassicChess.new()
		engine.load_fen(fen)
		var stats = {"nodes": 0}
		var ok = forced_mate(engine, new_ai(level), moves, stats)
		expect(ok, "level %d solves mate in %d: %s" % [level, moves, fen])
		if ok:
			solved[key] += 1
		nodes_used[key] = maxi(nodes_used[key], stats.nodes)

func run() -> void:
	var started = Time.get_ticks_msec()
	run_mates(MATE1, 1, 4, "m1")
	run_mates(MATE2, 2, 4, "m2")
	run_mates(MATE3, 3, 4, "m3")
	print("mates solved at level 4: m1 %d/%d, m2 %d/%d, m3 %d/%d" % [solved.m1, MATE1.size(), solved.m2, MATE2.size(), solved.m3, MATE3.size()])
	for entry in WIN_MATERIAL:
		var engine = ClassicChess.new()
		engine.load_fen(entry[0])
		var choice = new_ai(4).choose_move(engine)
		expect(choice.ok and (choice.from + choice.to) in entry[1], "level 4 wins the hanging piece: %s -> %s" % [entry[0], choice.from + choice.to])
	for entry in SAVE_PIECE:
		var engine = ClassicChess.new()
		engine.load_fen(entry[0])
		var choice = new_ai(4).choose_move(engine)
		expect(choice.ok, "a move is found: " + entry[0])
		engine.move(choice.from, choice.to, "q")
		var square = engine.board.find(entry[1])
		var enemy = "b" if entry[2] == "w" else "w"
		expect(square >= 0 and not engine.attacked(square, enemy), "level 4 saves the attacked %s: %s -> %s" % [entry[1], entry[0], choice.from + choice.to])
	var total = MATE1.size() + MATE2.size() + MATE3.size() + WIN_MATERIAL.size() + SAVE_PIECE.size()
	expect(total >= 25, "at least 25 tactical positions (have %d)" % total)
	print("TACTICS: %d positions, max AI nodes per mate line m1 %d m2 %d m3 %d, %.1f s" % [total, nodes_used.m1, nodes_used.m2, nodes_used.m3, (Time.get_ticks_msec() - started) / 1000.0])
	await run_budget_and_cancel()
	print("AI TACTICS: ", checks, " checks; failures=", failures.size())
	quit(0 if failures.is_empty() else 1)

func run_budget_and_cancel() -> void:
	# --- wall-clock budget: the search stops near the requested time even when the node cap would allow far more ---
	var kiwipete = ClassicChess.new()
	kiwipete.load_fen("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1")
	for budget in [150, 400, 900]:
		var ai = ChessAI.new(6, 1)
		var r = ai.choose_move(kiwipete, {"time_ms": budget, "node_limit": 10000000})
		expect(r.ok and r.elapsed_ms <= budget + 400 and r.elapsed_ms >= budget * 0.5, "time budget %d ms respected (took %.0f ms, %d nodes)" % [budget, r.elapsed_ms, r.nodes])
		print("budget %d ms -> %.0f ms, depth %d, %d nodes (%.0f nodes/s, software-only measurement)" % [budget, r.elapsed_ms, r.depth, r.nodes, r.nodes / (r.elapsed_ms / 1000.0)])
	# --- every level returns a legal move quickly enough on the start position at its shipped budget ---
	for level in range(1, 7):
		var ai = ChessAI.new(level, 9)
		var start = ClassicChess.new()
		var r = ai.choose_move(start)
		var allowed = ChessAI.LEVELS[level].time_ms
		expect(r.ok and r.elapsed_ms <= allowed + 500, "level %d answers within its %d ms budget (took %.0f ms)" % [level, allowed, r.elapsed_ms])
	# --- worker thread: the main loop keeps running, the result is legal ---
	var job = ChessAIJob.new()
	var ai = ChessAI.new(5, 2)
	job.start(kiwipete, ai, {"time_ms": 600})
	expect(job.state == "running" and not job.sliced or not ChessAIJob.threads_available(), "job starts on a worker thread when threads exist")
	var frames = 0
	while not job.poll():
		frames += 1
		await process_frame
	expect(job.state == "done" and job.result.ok and frames >= 5, "worker search finished while the main loop kept running (%d frames)" % frames)
	var legal = false
	for m in kiwipete.legal_moves():
		legal = legal or (ClassicChess.square(m.from) == job.result.from and ClassicChess.square(m.to) == job.result.to)
	expect(legal, "worker search returned a legal move")
	# --- cancellation: a long search stops within a fraction of a second and leaves no thread behind ---
	var long_job = ChessAIJob.new()
	long_job.start(kiwipete, ChessAI.new(6, 2), {"time_ms": 20000, "node_limit": 100000000})
	await create_timer(0.15).timeout
	var t0 = Time.get_ticks_msec()
	long_job.cancel()
	var took = Time.get_ticks_msec() - t0
	expect(long_job.state == "cancelled" and took < 700, "cancel() returns quickly (%d ms)" % took)
	expect(not long_job.poll() and long_job.result.is_empty(), "a cancelled job never delivers a result")
	# --- sliced mode (no threads): identical API, advances only inside poll() ---
	var sliced = ChessAIJob.new()
	sliced.start(kiwipete, ChessAI.new(4, 2), {"time_ms": 700}, true)
	var polls = 0
	while not sliced.poll() and polls < 2000:
		polls += 1
		await process_frame
	expect(sliced.sliced and sliced.state == "done" and sliced.result.ok and polls > 1, "sliced search completes over several frames (%d polls)" % polls)
	var sliced_cancel = ChessAIJob.new()
	sliced_cancel.start(kiwipete, ChessAI.new(6, 2), {"time_ms": 20000, "node_limit": 100000000}, true)
	sliced_cancel.poll()
	sliced_cancel.cancel()
	expect(sliced_cancel.state == "cancelled", "sliced job can be cancelled")
	# --- restarting a job on a new position cancels the old one ---
	var restart = ChessAIJob.new()
	var ai2 = ChessAI.new(6, 2)
	restart.start(kiwipete, ai2, {"time_ms": 20000, "node_limit": 100000000})
	restart.start(ClassicChess.new(), ai2, {"time_ms": 150})
	while not restart.poll():
		await process_frame
	expect(restart.result.ok, "a job can be restarted after being superseded")
	long_job.cancel()
