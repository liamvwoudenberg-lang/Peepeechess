# Local development needs no cloud keys. Node persists to SQLite and starts a
# local PeerJS signaling server automatically. Open http://localhost:3000.
# PORT=3000
# CHESS_DATABASE=/absolute/path/to/chess.sqlite

# Vercel: create an Upstash Redis database and add BOTH server-only variables
# in Project > Settings > Environment Variables, then redeploy.
# Never prefix these with VITE_. Never commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: your separately hosted PeerServer. Vercel uses the public PeerJS
# cloud by default; Vercel Functions do not host persistent WebSockets.
# PEER_HOST=signal.example.com
# PEER_PORT=443
# PEER_PATH=/
# PEER_SECURE=true
# PEER_KEY=peerjs

# Recommended for restrictive networks: managed TURN over TLS/TCP.
# For coturn REST authentication, one-hour credentials are generated per player;
# the shared secret stays on the server and is NEVER sent to browsers.
# TURN_URLS=turns:turn.example.com:443?transport=tcp,turn:turn.example.com:3478?transport=tcp
# TURN_SHARED_SECRET=

# Alternative: provider-issued ICE configuration. Use temporary TURN credentials.
# CHESS_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:443?transport=tcp","username":"temporary-user","credential":"temporary-password"}]

# Optional, public: preconfigure the online website in a rebuilt Android APK.
# VITE_PUBLIC_GAME_URL=https://your-game.vercel.app
