# /etc/peepeechess/server.env  (chmod 600, owner root). Copy from this template; NEVER commit the real file, never paste it into chat or an issue.
# Everything the server needs is configured here or in the systemd unit; nothing is baked into the build.
BIND=0.0.0.0
PORT=2456
# DTLS certificate and key (PEM). tools/deploy/remote/make_cert.sh creates a self-signed pair for this VM's address (clients pin it).
CERTIFICATE=/etc/peepeechess/server.crt
PRIVATE_KEY=/etc/peepeechess/server.key
# Refuse clients whose game build / combat tuning differs from this server's: match = refuse a different tuning, require = also refuse
# clients that send no build at all (use "require" on a public server), off = no check.
PEEPEECHESS_BUILD_CHECK=require
# Battle chess is untimed: the side to move forfeits after this many seconds without a move (0 = never). 180 = three minutes.
PEEPEECHESS_MOVE_TIMEOUT_SECONDS=180
# Optional extra server arguments, for example an account/ranking backend (leave empty for a plain friends server):
#   EXTRA_ARGS=--backend-url=https://api.example.invalid --server-id=vps-1
# and then also set PEEPEECHESS_BACKEND_SECRET below (the shared secret the server uses to report results; read from the environment only).
EXTRA_ARGS=
#PEEPEECHESS_BACKEND_SECRET=
