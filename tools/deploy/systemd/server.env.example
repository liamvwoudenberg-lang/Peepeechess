# /etc/peepeechess/server.env  (chmod 600, owner root). Copy from this template; NEVER commit the real file.
BIND=0.0.0.0
PORT=2456
# DTLS certificate and key for the UDP endpoint (PEM). Self-signed is fine for testing; clients must trust it.
CERTIFICATE=/etc/peepeechess/server.crt
PRIVATE_KEY=/etc/peepeechess/server.key
# Account/ranking backend (the HTTPS API) and this server's identity.
BACKEND_URL=https://api.example.invalid
SERVER_ID=oracle-a1-1
# Shared secret the server uses to report results to the backend (read from the environment by the server).
PEEPEECHESS_BACKEND_SECRET=change-me
