[Unit]
Description=Peepeechess dedicated server (ENet/DTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peepeechess
Group=peepeechess
# /opt/peepeechess/current is a symlink to the active release (see remote/install_release.sh); rollback = repoint it.
WorkingDirectory=/opt/peepeechess/current
EnvironmentFile=/etc/peepeechess/server.env
ExecStart=/opt/peepeechess/current/run-server.sh --bind=${BIND} --port=${PORT} --certificate=${CERTIFICATE} --private-key=${PRIVATE_KEY} $EXTRA_ARGS
Restart=on-failure
RestartSec=3
# small single-process game server: sandboxed and inside a memory budget. 640M leaves room for the OS on a 1 GB VM (VM.Standard.E2.1.Micro);
# raise it on a bigger machine with: systemctl edit peepeechess-server  ->  [Service] MemoryMax=2G
MemoryMax=640M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/peepeechess
Environment=HOME=/var/lib/peepeechess
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
