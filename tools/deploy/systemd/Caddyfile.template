# /etc/caddy/Caddyfile (generated by bootstrap_accounts.sh; @DOMAIN@ is replaced). Caddy gets and renews the HTTPS certificate by itself.
@DOMAIN@ {
	# Server-to-server endpoints (game server -> account service) are never reachable from the internet; the game server uses loopback.
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:8787
}
