# /etc/peepeechess/accounts.env  (chmod 600, owner root). bootstrap_accounts.sh creates it with a freshly generated secret; NEVER commit the real file or paste it anywhere.
NATIVE_API_BIND=127.0.0.1
NATIVE_API_PORT=8787
NATIVE_SERVER_ID=vps-1
# Shared secret between this service and the game server (generated on the VM; enable_accounts.sh copies it into the game server's environment).
NATIVE_SERVER_SECRET=generated-on-the-vm
# The game endpoint advertised to players after they log in. The server's DTLS certificate is advertised with it (run-accounts.sh reads /etc/peepeechess/server.crt).
NATIVE_GAME_HOST=203.0.113.10
NATIVE_GAME_PORT=2456
NATIVE_GAME_SERVER_NAME=203.0.113.10
# Storage: SQLite (one file; fine for a friends-scale server; back it up) unless DATABASE_URL (PostgreSQL) is set. NODE_ENV must stay unset for SQLite.
NATIVE_DATABASE_PATH=/var/lib/peepeechess/accounts.sqlite
#DATABASE_URL=postgres://user:password@host/dbname
